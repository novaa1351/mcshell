pkgbase = mcshell
	pkgdesc = A Linux desktop that uses Minecraft as its shell, on Sway
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/novaa1351/mcshell
	arch = any
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-hatchling
	depends = sway
	depends = swaybg
	depends = swaylock
	depends = hyprlock
	depends = polkit-gnome
	depends = foot
	depends = python
	depends = python-i3ipc
	depends = python-pyxdg
	depends = python-dbus-next
	depends = python-gobject
	depends = python-cairo
	depends = gtk4
	depends = gtk4-layer-shell
	depends = prismlauncher
	depends = jdk21-openjdk
	depends = curl
	depends = zstd
	depends = systemd
	optdepends = pipewire-pulse: the Sound page, and notification sounds (pactl, paplay)
	optdepends = wireplumber: volume keys and the volume bar (wpctl)
	optdepends = networkmanager: the Network page, and deciding to boot offline
	optdepends = bluez-utils: the Bluetooth group on the Network page
	optdepends = grim: F2 screenshots
	optdepends = wl-clipboard: F2 screenshots, to the clipboard
	optdepends = libnotify: the toast after a screenshot
	optdepends = brightnessctl: brightness keys and the Video page's brightness
	optdepends = playerctl: media play/pause/next keys
	optdepends = socat: the volume bar at 0% and 100%, and the boot screen's offline line
	optdepends = wlr-randr: the boot background's size before sway starts
	optdepends = librsvg: icons for apps that ship only an SVG
	optdepends = imagemagick: the lock screen's third fallback
	optdepends = pciutils: the GPU line on the Statistics screen
	optdepends = zenity: sudo and Wi-Fi password prompts, if no ssh-askpass is installed
	optdepends = xdg-desktop-portal-gtk: choosing the notification sound
	optdepends = gtk3: session/probes/clickprobe.py, the input instrument
	noextract = mcshell-0.1.0.jar
	noextract = mcshell-0.1.0.mrpack
	source = mcshell-0.1.0.tar.gz::https://github.com/novaa1351/mcshell/releases/download/v0.1.0/mcshell-0.1.0.tar.gz
